{
  "schemaVersion": 1,
  "id": "sol_valheim",
  "version": "${version}",
  "name": "SOL: Valheim",
  "description": "Food variety grants temporary health and regeneration, inspired by Valheim.",
  "authors": [
    "vice",
    "txnimc",
    "AbyssLasea"
  ],
  "license": "LGPL-3.0-or-later",
  "environment": "*",
  "entrypoints": {
    "main": [
      "vice.sol_valheim.fabric.FabricInitializer"
    ],
    "client": [
      "vice.sol_valheim.fabric.FabricClientInitializer"
    ],
    "modmenu": [
      "vice.sol_valheim.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "sol_valheim-common.mixins.json",
    "sol_valheim.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "cloth-config": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
